root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.cs]

csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_found = true:suggestion

csharp_new_line_before_open_brace = methods, types, namespaces, control_blocks

csharp_new_line_before_members_in_chained_calls = true

dotnet_diagnostic.IDE0005.severity = error  # Remove unused usings = erro
